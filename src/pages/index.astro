---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ModuleCard from '../components/ModuleCard.astro';
import { facetsOf } from '../lib/filter.js';
import { byPin } from '../lib/pinned.js';

const modules = (await getCollection('modules')).sort(byPin());

const counts = new Map();
for (const m of modules) for (const f of facetsOf(m.data)) counts.set(f, (counts.get(f) ?? 0) + 1);

// One chip mechanism, four groups. A group with a single value filters nothing — drop it.
const groups = ['category', 'stage', 'benchmark', 'tag']
  .map((group) => [
    group,
    [...counts.entries()]
      .filter(([f]) => f.startsWith(`${group}:`))
      .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])),
  ])
  .filter(([, values]) => values.length > 1);
---

<Base>
  <h1 class="text-3xl font-semibold tracking-tight">Modules</h1>
  <p class="mt-2 max-w-2xl text-zinc-600 dark:text-zinc-400">
    Reusable omnibenchmark modules, contributed by the community. Open a pull request to add yours.
  </p>

  <div class="mt-8 space-y-4">
    <input
      id="q"
      type="search"
      placeholder="Search modules…"
      autocomplete="off"
      class="w-full rounded-lg border border-zinc-200 bg-white px-4 py-2.5 text-sm outline-none placeholder:text-zinc-400 focus:border-zinc-400 dark:border-zinc-800 dark:bg-zinc-900 dark:focus:border-zinc-600"
    />

    {groups.map(([group, values]) => (
      <div class="flex flex-wrap items-baseline gap-1.5">
        <span class="w-20 shrink-0 text-xs text-zinc-400 dark:text-zinc-500">{group}</span>
        {values.map(([facet, count]) => (
          <button
            type="button"
            data-chip={facet}
            aria-pressed="false"
            class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium text-zinc-600 ring-1 ring-zinc-200 ring-inset transition hover:bg-zinc-100 aria-pressed:bg-zinc-900 aria-pressed:text-white aria-pressed:ring-zinc-900 dark:text-zinc-300 dark:ring-zinc-700 dark:hover:bg-zinc-800 dark:aria-pressed:bg-zinc-100 dark:aria-pressed:text-zinc-900 dark:aria-pressed:ring-zinc-100"
          >
            {facet.slice(group.length + 1)}<span class="opacity-60">{count}</span>
          </button>
        ))}
      </div>
    ))}

    <p id="count" class="text-sm text-zinc-500 dark:text-zinc-400">{modules.length} modules</p>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {modules.map((entry) => <ModuleCard entry={entry} />)}
  </div>

  <p id="empty" hidden class="mt-6 text-zinc-500 dark:text-zinc-400">
    No modules match. <button type="button" id="reset" class="underline underline-offset-4">Clear filters</button>
  </p>

  <nav id="pager" hidden aria-label="Pagination" class="mt-8 flex items-center justify-center gap-4 text-sm">
    <button type="button" data-step="-1" class="rounded-lg px-3 py-1.5 ring-1 ring-zinc-200 ring-inset hover:bg-zinc-100 disabled:opacity-40 disabled:hover:bg-transparent dark:ring-zinc-700 dark:hover:bg-zinc-800">Previous</button>
    <span id="pageinfo" aria-live="polite" class="text-zinc-500 dark:text-zinc-400"></span>
    <button type="button" data-step="1" class="rounded-lg px-3 py-1.5 ring-1 ring-zinc-200 ring-inset hover:bg-zinc-100 disabled:opacity-40 disabled:hover:bg-transparent dark:ring-zinc-700 dark:hover:bg-zinc-800">Next</button>
  </nav>
</Base>

<script>
  import { matches } from '../lib/filter.js';

  // ponytail: every card is server-rendered and pagination just hides the rest, so search
  // and chips still span the whole registry and the list works with JS off. Switch to
  // Astro's paginate() once the payload matters — past a few hundred entries.
  const PER_PAGE = 12;

  const input = document.getElementById('q');
  const chips = [...document.querySelectorAll('[data-chip]')];
  const cards = [...document.querySelectorAll('[data-card]')];
  const count = document.getElementById('count');
  const empty = document.getElementById('empty');
  const pager = document.getElementById('pager');
  const pageinfo = document.getElementById('pageinfo');
  const steps = [...pager.querySelectorAll('[data-step]')];
  let page = 1;

  const active = () => chips.filter((c) => c.ariaPressed === 'true').map((c) => c.dataset.chip);

  function apply(push = true) {
    const q = input.value;
    const facets = active();
    const hits = cards.filter((card) =>
      matches(
        { haystack: card.dataset.haystack, facets: card.dataset.facets.split(' ') },
        q,
        facets,
      ),
    );

    const pages = Math.max(1, Math.ceil(hits.length / PER_PAGE));
    page = Math.min(Math.max(page, 1), pages);
    const start = (page - 1) * PER_PAGE;
    const shown = new Set(hits.slice(start, start + PER_PAGE));
    for (const card of cards) card.hidden = !shown.has(card);

    count.textContent =
      hits.length === cards.length ? `${hits.length} modules` : `${hits.length} of ${cards.length} modules`;
    empty.hidden = hits.length > 0;
    pager.hidden = pages < 2;
    pageinfo.textContent = `Page ${page} of ${pages}`;
    for (const b of steps) b.disabled = page + Number(b.dataset.step) < 1 || page + Number(b.dataset.step) > pages;

    if (!push) return;
    const params = new URLSearchParams();
    if (q.trim()) params.set('q', q.trim());
    if (facets.length) params.set('f', facets.join(','));
    if (page > 1) params.set('p', String(page));
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  // A different result set invalidates the page number.
  const refilter = () => {
    page = 1;
    apply();
  };

  const params = new URLSearchParams(location.search);
  input.value = params.get('q') ?? '';
  page = Number(params.get('p')) || 1;
  const wanted = (params.get('f') ?? '').split(',').filter(Boolean);
  for (const chip of chips) chip.ariaPressed = String(wanted.includes(chip.dataset.chip));

  input.addEventListener('input', refilter);
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      chip.ariaPressed = chip.ariaPressed === 'true' ? 'false' : 'true';
      refilter();
    });
  }
  for (const b of steps) {
    b.addEventListener('click', () => {
      page += Number(b.dataset.step);
      apply();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
  document.getElementById('reset').addEventListener('click', () => {
    input.value = '';
    for (const chip of chips) chip.ariaPressed = 'false';
    refilter();
  });

  apply(false);
</script>
