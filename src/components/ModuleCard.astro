---
import { facetsOf, haystackOf } from '../lib/filter.js';
import { formatDate, updatedAt } from '../lib/updated.js';
import { href } from '../lib/url.js';

const { entry } = Astro.props;
const m = entry.data;
const updated = formatDate(updatedAt(entry.id));
---

<article
  data-card
  data-facets={facetsOf(m).join(' ')}
  data-haystack={haystackOf(m)}
  class="group relative flex flex-col rounded-xl border border-zinc-200 bg-white p-5 transition hover:border-zinc-300 hover:shadow-sm dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold tracking-tight">
      <a href={href(`/modules/${entry.id}/`)} class="underline-offset-4 after:absolute after:inset-0 hover:underline">
        {m.name}
      </a>
    </h3>
    <span class="shrink-0 rounded-md bg-zinc-100 px-2 py-0.5 font-mono text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
      {m.stage}
    </span>
  </div>

  <p class="mt-2 line-clamp-3 text-sm text-zinc-600 dark:text-zinc-400">{m.description}</p>

  <div class="mt-4 flex flex-wrap items-center gap-1.5">
    {m.category === 'generic' && (
      <span class="rounded-full px-2 py-0.5 text-xs text-zinc-500 ring-1 ring-zinc-200 ring-inset dark:text-zinc-400 dark:ring-zinc-700">generic</span>
    )}
    {m.tags.map((t) => (
      <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">{t}</span>
    ))}
    {updated && <span class="ml-auto font-mono text-xs text-zinc-400 dark:text-zinc-500">{updated}</span>}
  </div>
</article>
