---
import '../styles/global.css';
import { href } from '../lib/url.js';

const { title, description = 'A community registry of omnibenchmark modules.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · obcommons` : 'obcommons'}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='14'>◇</text></svg>" />
  </head>
  <body class="min-h-screen bg-zinc-50 font-sans text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100">
    <header class="border-b border-zinc-200 bg-white/80 backdrop-blur dark:border-zinc-800 dark:bg-zinc-900/60">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
        <a href={href('/')} class="flex items-baseline gap-2">
          <span class="text-lg font-semibold tracking-tight">obcommons</span>
          <span class="hidden text-sm text-zinc-500 sm:inline dark:text-zinc-400">omnibenchmark module registry</span>
        </a>
        <a
          href="https://github.com/omnibenchmark/obcommons"
          class="rounded-md px-3 py-1.5 text-sm font-medium text-zinc-600 ring-1 ring-zinc-200 ring-inset hover:bg-zinc-100 dark:text-zinc-300 dark:ring-zinc-700 dark:hover:bg-zinc-800"
        >
          Add a module
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-10"><slot /></main>

    <footer class="mx-auto max-w-5xl px-4 py-10 text-sm text-zinc-500 dark:text-zinc-400">
      <a href={href('/modules.json')} class="underline underline-offset-4 hover:text-zinc-900 dark:hover:text-zinc-100">modules.json</a>
      <span class="px-2">·</span>
      <a href="https://omnibenchmark.org" class="underline underline-offset-4 hover:text-zinc-900 dark:hover:text-zinc-100">omnibenchmark</a>
    </footer>
  </body>
</html>
